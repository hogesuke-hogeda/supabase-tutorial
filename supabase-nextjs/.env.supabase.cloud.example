# Replace <project-ref> with your hosted Supabase project ref.
# Replace <cloud-publishable-key> with the hosted publishable key from the
# Supabase Dashboard Connect dialog or Settings > API Keys.
SITE_URL=http://localhost:3000
SUPABASE_SERVER_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<cloud-publishable-key>
