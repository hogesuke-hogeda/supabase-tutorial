# Replace <project-ref> with your hosted Supabase project ref.
# Replace <cloud-publishable-key> with the publishable key shown by `supabase status`
# or in Supabase Studio / project settings.
SUPABASE_SERVER_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<cloud-publishable-key>
