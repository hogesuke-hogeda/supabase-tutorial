# Replace <gateway-ip> with the result of `ip route | awk '/default/ { print $3 }'`
# when Next.js runs inside a devcontainer or Docker container.
# Replace <your-publishable-key> with the publishable key shown by `npx supabase status`
# or in Supabase Studio / local project settings.
SUPABASE_SERVER_URL=http://<gateway-ip>:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
